# ALLOW-LIST. Everything is ignored unless listed below.
#
# Why an allow-list and not a block-list: this folder also holds files built
# from the LICENSED Signal Four crash records (Excel exports, HTML maps and
# JSON with crash points), text copied from third-party project documents, and
# large downloads. A block-list only protects against files someone remembered
# to name. An allow-list means a new data file can never be committed by accident.

*
!*/

# code and documents only
!*.py
!*.md
!.gitignore

# Aggregate RESULTS only. data/final holds mode-level and block-group
# totals with no crash-record fields in them, at the same scale the
# Signal Four public dashboard publishes and step 37 checks against.
# data/raw, data/interim and data/processed stay ignored: those hold the
# licensed records themselves and the matrices built directly from them.
!data/final/*.csv

# never commit caches
__pycache__/
.pytest_cache/
